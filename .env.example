# =============================================================================
# Public / publishable only. Vite inlines VITE_* into the browser bundle.
# Never put secrets behind a VITE_ prefix. See AGENTS.md §3.
# =============================================================================

# Clerk: same instance as ACCESS. Consume only — do not change Clerk dashboard,
# pool, apps, redirects, or migrate pk_test → pk_live in this repo.
# VITE_CLERK_PUBLISHABLE_KEY is set in the Vercel project env (and currently
# also in vercel.json as pk_test mighty-owl). Do not flip it to pk_live here.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

VITE_ACCESS_URL=https://getaccess.world
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51RpDLkQevxkpi1fsWdANpVEJ03hk0tbugP4kisGeniREwZeMKwczkPfuXUFyHNdmYobl0vTCk5zgttDvw5EQ9Dvu00w2UBawjC
VITE_STRIPE_SUCCESS_URL=https://accounts.jdproductions.io/dashboard
VITE_STRIPE_CANCEL_URL=https://accounts.jdproductions.io/pricing
VITE_APP_NAME=JD Productions Accounts

# =============================================================================
# Server-only (api/ + db scripts). Set these in the Vercel project Environment
# Variables UI as Sensitive. Do NOT add them to vercel.json.
# =============================================================================

# Postgres for this project (Vercel Marketplace / Neon / equivalent).
# Not ACCESS Supabase.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Stripe secret + webhook signing secret (restricted key preferred).
STRIPE_SECRET_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: fixed Stripe Price for Early Support. If unset, checkout uses
# EARLY_SUPPORT_AMOUNT_CENTS or the request body amount_cents (clamped).
# STRIPE_PRICE_ID=price_...
EARLY_SUPPORT_AMOUNT_CENTS=10000
EARLY_SUPPORT_MIN_AMOUNT_CENTS=1000
EARLY_SUPPORT_MAX_AMOUNT_CENTS=10000000
EARLY_SUPPORT_TERMS_VERSION=early_support_v0
# Public origin used to build default success/cancel/terms URLs.
# ACCOUNTS_APP_URL=https://accounts.jdproductions.io
# EARLY_SUPPORT_SUCCESS_URL=https://accounts.jdproductions.io/early-support/success?session_id={CHECKOUT_SESSION_ID}
# EARLY_SUPPORT_CANCEL_URL=https://accounts.jdproductions.io/early-support
# EARLY_SUPPORT_TERMS_URL=https://accounts.jdproductions.io/early-support/terms
# EARLY_SUPPORT_PRIVACY_URL=https://accounts.jdproductions.io/early-support/privacy
# EARLY_SUPPORT_SUPPORT_EMAIL=hello@jdproductions.io

# Clerk secret for verifying session JWTs on api/positions, api/positions/claim,
# and optional Bearer on api/stripe/checkout. Guest checkout does not require it.
# Server-only. Never VITE_. Do not rotate or replace the shared pool key here.
CLERK_SECRET_KEY=sk_test_...
