{
  "name": "jd-productions-saas",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZ2V0YWNjZXNzLndvcmxkJA",
    "VITE_STRIPE_PUBLISHABLE_KEY": "pk_live_51RpDLkQevxkpi1fsWdANpVEJ03hk0tbugP4kisGeniREwZeMKwczkPfuXUFyHNdmYobl0vTCk5zgttDvw5EQ9Dvu00w2UBawjC",
    "VITE_STRIPE_SUCCESS_URL": "https://accounts.jdproductions.io/dashboard",
    "VITE_STRIPE_CANCEL_URL": "https://accounts.jdproductions.io/pricing",
    "VITE_APP_NAME": "JD Productions Accounts",
    "VITE_ACCESS_URL": "https://getaccess.world"
  },
  "headers": [
    {
      "source": "/auth/session-share",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://invest.jdproductions.io https://www.invest.jdproductions.io"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/invest",
      "has": [{ "type": "host", "value": "invest.jdproductions.io" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/invest",
      "has": [{ "type": "host", "value": "www.invest.jdproductions.io" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/invest",
      "destination": "/early-support",
      "permanent": true
    }
  ]
}
